generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
  CRITICAL
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         String   @default("EMPLOYEE") // DIRECTOR | TL | EMPLOYEE
  profilePhoto String?
  isActive     Boolean  @default(true)

  // Team this user is a MEMBER of
  teamId       Int?
  team         Team?    @relation("TeamMembers", fields: [teamId], references: [id])

  // Team this user LEADS (only for TLs)
  managedTeam  Team?    @relation("TeamLeader")

  // Tasks
  assignedTasks Task[]        @relation("TaskAssignee")
  createdTasks  Task[]        @relation("TaskCreator")
  reviewedTasks Task[]        @relation("TaskReviewer")
  taskComments  TaskComment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  isActive     Boolean  @default(true)

  members      User[]   @relation("TeamMembers")

  teamLeaderId Int?     @unique
  teamLeader   User?    @relation("TeamLeader", fields: [teamLeaderId], references: [id])

  tasks        Task[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  priority    TaskPriority   @default(MEDIUM)
  difficulty  TaskDifficulty @default(MEDIUM)
  status      TaskStatus     @default(ASSIGNED)
  deadline    DateTime?

  // Points this task is worth, and what was actually awarded on approval
  points        Int  @default(10)
  awardedPoints Int?

  // Who it is assigned to / who created it
  assignedToId Int
  assignedTo   User @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdById  Int
  createdBy    User @relation("TaskCreator", fields: [createdById], references: [id])

  // Team at the time the task was assigned (used for team performance later)
  teamId       Int?
  team         Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Submission
  submissionNote String?
  submittedAt    DateTime?

  // Review
  reviewedById   Int?
  reviewedBy     User?     @relation("TaskReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewFeedback String?
  completedAt    DateTime?

  comments     TaskComment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([teamId])
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  content   String

  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
}