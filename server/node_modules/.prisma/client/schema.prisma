generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
  CRITICAL
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

enum PointType {
  TASK_APPROVAL
  BONUS
  ADJUSTMENT
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  password     String
  role         String  @default("EMPLOYEE") // DIRECTOR | TL | EMPLOYEE
  profilePhoto String?
  isActive     Boolean @default(true)

  // Password safety
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  // Team this user is a MEMBER of
  teamId Int?
  team   Team? @relation("TeamMembers", fields: [teamId], references: [id])

  // Team this user LEADS (only for TLs)
  managedTeam Team? @relation("TeamLeader")

  // Tasks
  assignedTasks Task[]        @relation("TaskAssignee")
  createdTasks  Task[]        @relation("TaskCreator")
  reviewedTasks Task[]        @relation("TaskReviewer")
  taskComments  TaskComment[]

  // Points ledger
  pointTransactions PointTransaction[] @relation("PointsEarned")
  pointsGiven       PointTransaction[] @relation("PointsGiven")

  // Employee of the Month
  monthWins        EmployeeOfMonth[] @relation("MonthWinner")
  winnersConfirmed EmployeeOfMonth[] @relation("WinnerConfirmedBy")

  // Ratings of Team Leaders
  votesCast     LeaderVote[] @relation("VotesCast")
  votesReceived LeaderVote[] @relation("VotesReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  members User[] @relation("TeamMembers")

  teamLeaderId Int?  @unique
  teamLeader   User? @relation("TeamLeader", fields: [teamLeaderId], references: [id])

  tasks             Task[]
  pointTransactions PointTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  priority    TaskPriority   @default(MEDIUM)
  difficulty  TaskDifficulty @default(MEDIUM)
  status      TaskStatus     @default(ASSIGNED)
  deadline    DateTime?

  // Points this task is worth, and what was actually awarded on approval
  points        Int  @default(10)
  awardedPoints Int?

  // Who it is assigned to / who created it
  assignedToId Int
  assignedTo   User @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdById Int
  createdBy   User @relation("TaskCreator", fields: [createdById], references: [id])

  // Team at the time the task was assigned (used for team performance later)
  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Submission
  submissionNote String?
  submittedAt    DateTime?

  // Review
  reviewedById   Int?
  reviewedBy     User?     @relation("TaskReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewFeedback String?
  completedAt    DateTime?

  comments          TaskComment[]
  pointTransactions PointTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([teamId])
}

model TaskComment {
  id      Int    @id @default(autoincrement())
  content String

  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
}

// Every point ever given or taken away. Totals are always calculated
// from these rows, so there is a full history and nothing is lost.
model PointTransaction {
  id     Int       @id @default(autoincrement())
  points Int // positive = earned, negative = taken away
  type   PointType
  reason String

  // Who received the points
  userId Int
  user   User @relation("PointsEarned", fields: [userId], references: [id])

  // The team at that moment (used for team competition)
  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // The task these points came from (task approvals only)
  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Who awarded them
  awardedById Int?
  awardedBy   User? @relation("PointsGiven", fields: [awardedById], references: [id])

  createdAt DateTime @default(now())

  // A task can only ever pay out once
  @@unique([taskId, type])
  @@index([userId, createdAt])
  @@index([teamId, createdAt])
}

// One winner per month, chosen by the Director.
// The points and team are saved as they were when the winner was chosen.
model EmployeeOfMonth {
  id Int @id @default(autoincrement())

  month String @unique // for example "2026-10"

  userId Int
  user   User @relation("MonthWinner", fields: [userId], references: [id])

  points   Int
  teamName String?
  note     String?

  confirmedById Int
  confirmedBy   User @relation("WinnerConfirmedBy", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An employee's 1 to 5 star rating of their Team Leader for one month.
// Each employee has one vote per month; voting again replaces it.
model LeaderVote {
  id Int @id @default(autoincrement())

  month   String // for example "2026-10"
  rating  Int // 1 to 5
  comment String?

  voterId Int
  voter   User @relation("VotesCast", fields: [voterId], references: [id])

  tlId Int
  tl   User @relation("VotesReceived", fields: [tlId], references: [id])

  // The team at that moment
  teamId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([voterId, month])
  @@index([tlId, month])
}
